# =============================================================================
# EXEMPLO de variáveis secretas do backend — NUNCA commitar valores reais.
#
# Uso em produção (VM GCP / Docker):
#   cp backend/secrets.env.example secrets/backend.env
#   # edite secrets/backend.env com valores reais
#   # o docker-compose.api.yml carrega secrets/backend.env via env_file
#
# Uso em desenvolvimento local (.NET):
#   dotnet user-secrets init
#   dotnet user-secrets set "Jwt:Key" "<chave-aleatoria-forte>"
# =============================================================================

# Chave de assinatura do JWT (OBRIGATÓRIA, >= 32 caracteres aleatórios).
# Gere com: openssl rand -base64 48   (ou: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_KEY=COLOQUE_UMA_CHAVE_ALEATORIA_FORTE_AQUI

# Connection string do banco (produção Docker usa SQLite persistente).
# ConnectionStrings__DefaultConnection=Data Source=/app/data/teleprompt.db

# Firebase (Firestore) — service account fica em ./secrets/firebase-service-account.json
# Firebase__ProjectId=teleprompt-1
# Firebase__ServiceAccountKey=/app/secrets/firebase-service-account.json
# Firebase__AutoImport=true
